# PVE Abuse Guard - Biến môi trường mẫu (Tùy chọn ghi đè cấu hình)

PVE_HOST=127.0.0.1
PVE_PORT=8006
PVE_USER=abuse-monitor@pam
PVE_TOKEN_NAME=pve-guard
PVE_TOKEN_VALUE=your-token-secret-uuid
PVE_VERIFY_SSL=false
PVE_WEB_UI_URL=https://pve.example.com:8006

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
COOLDOWN_MINUTES=60
NOTIFY_ON_RESOLVED=true
DISCORD_MENTION_ROLE_ID=
DISCORD_MENTION_USER_ID=

CPU_THRESHOLD_PERCENT=90.0
DURATION_MINUTES=30
POLL_INTERVAL_SECONDS=60

AUTO_ACTION_ENABLED=false
AUTO_ACTION_DRY_RUN=true
AUTO_ACTION_TYPE=suspend

LOG_LEVEL=INFO
